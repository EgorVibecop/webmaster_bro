# Правила для Apache на российском хостинге (папка сайта). Кладутся рядом с index.html.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # www -> без www, http -> https (если хостинг сообщает схему через заголовок прокси, учитываем его)
  RewriteCond %{REQUEST_URI} !^/.well-known/acme-challenge/ [NC]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
  # Проверочные файлы выпуска сертификата (Let's Encrypt) должны открываться по http без перенаправления
  RewriteCond %{REQUEST_URI} !^/.well-known/acme-challenge/ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Типы файлов, которых может не быть в настройках хостинга
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType text/plain .txt
</IfModule>

# Сжатие
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/plain application/xml
</IfModule>

# Кэш: файлы с хэшем в имени (/_astro/) можно хранить год, остальное картинки и скрипты неделю, страницы почти не кэшируем
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 10 minutes"
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType image/avif "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^.*$">
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # HTTPS работает на всех страницах и сертификат выпущен: браузеры теперь запоминают, что сайт только по https
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

---
// Единый блок «форма + прямые контакты». Используется на главной, на каждой
// странице услуги и в каждой статье блога – чтобы человек не уходил с
// прочитанной страницы, чтобы задать вопрос.
import { FORM_ENDPOINT_RU, ASSET_V } from '../config.js';

interface Props {
  heading?: string;
  subheading?: string;
  presetService?: string;
}
const {
  heading = 'Расскажите о задаче – предложим метод и сроки',
  subheading,
  presetService,
} = Astro.props;
---
<section id="contact" class="contact">
  <div class="contact-grid">
    <div class="contact-form-col">
      <div>
        <h2>{heading}</h2>
        {subheading && <p class="contact-subheading">{subheading}</p>}
      </div>
      <form class="form-grid" id="lead-form" name="brief" novalidate data-endpoint-ru={FORM_ENDPOINT_RU}>
        <div>
          <label class="field-label" for="f-name">Имя <span class="req">*</span></label>
          <input class="field" id="f-name" name="name" type="text" autocomplete="name" maxlength="100" placeholder="Как к вам обращаться" required />
        </div>
        <div>
          <label class="field-label" for="f-company">Компания</label>
          <input class="field" id="f-company" name="company" type="text" autocomplete="organization" maxlength="150" placeholder="Название компании" />
        </div>
        <div>
          <label class="field-label" for="f-email">Email <span class="req">*</span></label>
          <input class="field" id="f-email" name="email" type="email" autocomplete="email" maxlength="150" placeholder="you@company.ru" aria-describedby="f-email-hint" required />
          <small class="field-hint" id="f-email-hint">Только латиница и цифры, без пробелов</small>
        </div>
        <div>
          <label class="field-label" for="f-phone">Телефон</label>
          <input class="field" id="f-phone" name="phone" type="tel" autocomplete="tel" maxlength="50" placeholder="+7 (___) ___-__-__" />
        </div>
        {presetService && <input type="hidden" name="service" value={presetService} />}
        <div class="full">
          <label class="field-label" for="f-message">Коротко о задаче</label>
          <textarea class="field" id="f-message" name="message" rows="4" maxlength="2000" placeholder="Что нужно узнать и к какому сроку"></textarea>
        </div>
        <div class="hp" aria-hidden="true">
          <label>Не заполняйте это поле <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <div class="full">
          <label class="consent">
            <input type="checkbox" name="consent" required />
            <span>Даю согласие на обработку персональных данных в соответствии с <a href="/privacy/" target="_blank" rel="noopener">Политикой обработки персональных данных</a> <span class="req">*</span></span>
          </label>
        </div>
        <div class="full submit-row">
          <button class="btn btn-primary" type="submit">Отправить заявку</button>
          <div class="required-note"><span class="req">*</span> Обязательные поля</div>
        </div>
        <div class="full form-status" id="form-status" role="status" aria-live="polite"></div>
      </form>
      <div class="form-success" id="form-success" role="status" aria-live="polite" hidden>
        <h3>Заявка успешно отправлена</h3>
        <p>Спасибо! Мы ответим в течение рабочего дня.</p>
      </div>
    </div>

    <div class="contact-card">
      <div>
        <div class="label">Телефон</div>
        <a class="phone-link" href="tel:+79774437588">+7 977 443-75-88</a>
      </div>
      <div class="divider"></div>
      <div>
        <div class="label">Email</div>
        <a class="value" href="mailto:info@baikalresearch.ru">info@baikalresearch.ru</a>
      </div>
      <div class="fine-print">Отвечаем на заявки в течение одного рабочего дня.</div>
    </div>
  </div>
</section>

<script is:inline src={`/js/lead-form.js?v=${ASSET_V}`} defer></script>

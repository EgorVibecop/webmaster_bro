---
import { services } from '../data/services.js';

---
<footer class="site-footer">
  <div class="footer-grid">
    <div class="footer-brand">
      <a class="footer-logo" href="/" aria-label="Baikal Research – на главную">
        <svg width="36" height="29" viewBox="0 0 32 26" fill="none" stroke="var(--accent)" stroke-linecap="round" aria-hidden="true">
          <path d="M2 6 Q9 1 16 6 T30 6" stroke-width="1.5"/>
          <path d="M2 13 Q9 8 16 13 T30 13" stroke-width="1.5" opacity="0.65"/>
          <path d="M2 20 Q9 15 16 20 T30 20" stroke-width="1.5" opacity="0.35"/>
          <circle cx="9" cy="7" r="6" fill="var(--night)" stroke-width="1.5"/>
          <circle cx="9" cy="7" r="2" fill="none" stroke-width="1.3"/>
          <path d="M6 12.2 L4 15" stroke-width="1.3"/>
          <path d="M12 12.2 L14 15" stroke-width="1.3"/>
        </svg>
        <span class="footer-brand-name">Baikal Research</span>
      </a>
      <span class="footer-brand-tag">Видим глубже</span>
      <div class="footer-contacts">
        <a href="tel:+79774437588">+7 977 443-75-88</a>
        <a href="mailto:info@baikalresearch.ru">info@baikalresearch.ru</a>
      </div>
    </div>
    <nav class="footer-col" aria-label="Все услуги">
      <div class="footer-col-title">Услуги</div>
      {services.map((s) => <a href={`/uslugi/${s.slug}/`}>{s.title}</a>)}
    </nav>
    <nav class="footer-col" aria-label="Разделы сайта">
      <div class="footer-col-title">Разделы</div>
      <a href="/uslugi/">Все услуги</a>
      <a href="/o-nas/">О нас</a>
      <a href="/kak-my-rabotaem/">Как мы работаем</a>
      <a href="/partneram/">Партнерам</a>
      <a href="/vakansii/">Вакансии</a>
      <a href="/blog/">Блог</a>
      <a href="/instrumenty/kalkulyator-vyborki/">Калькулятор выборки</a>
      <a href="/glossariy/">Словарь терминов</a>
      <a href="/kontakty/">Контакты</a>
      <a href="/privacy/">Политика конфиденциальности</a>
    </nav>
  </div>
  <div class="footer-legal">
    <span>© 2026 Baikal Research (Байкал Рисерч). Агентство маркетинговых и продуктовых исследований.</span>
  </div>
</footer>

---
import { services } from '../data/services.js';

interface Props {
  contactHref?: string;
}
const { contactHref = '/#contact' } = Astro.props;
---
<footer class="site-footer">
  <div class="footer-grid">
    <div class="footer-brand">
      <span class="footer-brand-name">Baikal Research</span>
      <span class="footer-brand-tag">Видим глубже</span>
      <div class="footer-contacts">
        <a href="tel:+79774437588">+7 977 443-75-88</a>
        <a href="mailto:baikalresearch@yandex.ru">baikalresearch@yandex.ru</a>
      </div>
    </div>
    <nav class="footer-col" aria-label="Все услуги">
      <div class="footer-col-title">Услуги</div>
      {services.map((s) => <a href={`/uslugi/${s.slug}/`}>{s.title}</a>)}
    </nav>
    <nav class="footer-col" aria-label="Разделы сайта">
      <div class="footer-col-title">Разделы</div>
      <a href="/#process">Как мы работаем</a>
      <a href="/blog/">Блог</a>
      <a href={contactHref}>Контакты</a>
      <a href="/privacy/">Политика конфиденциальности</a>
    </nav>
  </div>
  <div class="footer-legal">
    <span>© 2026 Baikal Research (Байкал Рисёрч). Агентство маркетинговых и продуктовых исследований.</span>
    <span>ИП Бахарев Егор Александрович · ОГРНИП 326774600729070</span>
  </div>
</footer>

---
interface Props {
  contactHref?: string;
}
const { contactHref = '/#contact' } = Astro.props;
---
<header class="site-header" id="site-header" data-nav-open="false">
  <a class="brand" href="/" aria-label="Baikal Research — на главную">
    <div class="brand-row">
      <svg width="30" height="24" viewBox="0 0 32 26" fill="none" stroke="var(--accent)" stroke-linecap="round" aria-hidden="true">
        <path d="M2 6 Q9 1 16 6 T30 6" stroke-width="1.5"/>
        <path d="M2 13 Q9 8 16 13 T30 13" stroke-width="1.5" opacity="0.65"/>
        <path d="M2 20 Q9 15 16 20 T30 20" stroke-width="1.5" opacity="0.35"/>
        <circle cx="9" cy="7" r="6" fill="var(--bg)" stroke-width="1.5"/>
        <circle cx="9" cy="7" r="2" fill="none" stroke-width="1.3"/>
        <path d="M6 12.2 L4 15" stroke-width="1.3"/>
        <path d="M12 12.2 L14 15" stroke-width="1.3"/>
      </svg>
      <span class="brand-name">Baikal Research</span>
    </div>
    <span class="brand-tagline">Видим глубже</span>
  </a>
  <button class="nav-toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Открыть меню">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
  </button>
  <nav class="main-nav" id="main-nav" aria-label="Основная навигация">
    <a href="/#services">Услуги</a>
    <a href="/#process">Как мы работаем</a>
    <a href="/blog/">Блог</a>
    <a href={contactHref}>Контакты</a>
  </nav>
  <div class="header-cta">
    <a class="btn btn-primary btn-sm" href={contactHref}>Обсудить задачу</a>
  </div>
</header>
<script is:inline src="/js/nav-toggle.js" defer></script>

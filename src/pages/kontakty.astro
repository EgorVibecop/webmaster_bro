---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactBlock from '../components/ContactBlock.astro';

const SITE = 'https://baikalresearch.ru';
const url = `${SITE}/kontakty/`;
const description = 'Контакты Baikal Research: телефон, почта, форма заявки. Отвечаем на заявки в течение одного рабочего дня.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'Контакты', item: url },
      ],
    },
    {
      '@type': 'ContactPage',
      '@id': `${url}#page`,
      url,
      name: 'Контакты Baikal Research',
      isPartOf: { '@id': `${SITE}/#website` },
      about: { '@id': `${SITE}/#org` },
    },
  ],
};
---
<BaseLayout title="Контакты – Baikal Research" description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <SiteHeader contactHref="#contact" />

  <main class="page page-wide">
    <nav class="breadcrumbs" aria-label="Хлебные крошки">
      <a href="/">Главная</a><span aria-hidden="true">/</span>
      <span aria-current="page">Контакты</span>
    </nav>

    <h1>Контакты</h1>
    <p class="lead">Позвоните, напишите на почту или оставьте заявку в форме ниже. Отвечаем в течение одного рабочего дня.</p>

    <div class="contact-facts">
      <div class="contact-fact">
        <div class="label">Телефон</div>
        <a class="value" href="tel:+79774437588">+7 977 443-75-88</a>
      </div>
      <div class="contact-fact">
        <div class="label">Email</div>
        <a class="value" href="mailto:info@baikalresearch.ru">info@baikalresearch.ru</a>
      </div>
      <div class="contact-fact">
        <div class="label">Срок ответа</div>
        <div class="value">В течение рабочего дня</div>
      </div>
    </div>
  </main>

  <ContactBlock
    heading="Расскажите о задаче"
    subheading="Предложим метод, выборку и сроки под вашу задачу и бюджет."
    showCard={false}
  />
  <SiteFooter />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ContactBlock from '../../components/ContactBlock.astro';

const SITE = 'https://baikalresearch.ru';
const url = `${SITE}/instrumenty/kalkulyator-vyborki/`;
const title = 'Сколько людей опросить: калькулятор выборки для опроса — Baikal Research';
const description = 'Пошаговый калькулятор: опишите группы респондентов и нужную точность простыми словами, получите, сколько людей опросить и почему так. Для тех, кто знает статистику, есть расчёт погрешности и значимости различий.';

const faq = [
  { q: 'Влияют ли типы вопросов на число респондентов?', a: 'Нет. Одиночный и множественный выбор считаются одинаково: у каждого варианта доля выбравших и та же точность. Открытые вопросы не увеличивают число людей, но их ответы нужно прочитать и разложить по темам.' },
  { q: 'Почему нельзя опросить 400 человек и разбить их на группы?', a: 'Точность считается внутри той группы, по которой вы делаете вывод. Если из 400 человек в группе окажется 60, вывод по ней будет очень приблизительным. Поэтому выборку считают на самую маленькую группу, по которой нужны отдельные выводы.' },
  { q: 'Какая выборка нужна для опроса?', a: 'Зависит от нужной точности. Для погрешности ±5 п.п. при доверительной вероятности 95% и неизвестной доле обычно достаточно около 385 респондентов, если аудитория большая. Для ±3 п.п. нужно около 1 070, для ±10 п.п. около 97.' },
  { q: 'Что такое доверительная вероятность и погрешность?', a: 'Погрешность показывает, насколько доля в выборке может отличаться от доли во всей аудитории. Доверительная вероятность говорит, как часто такая оценка попадает в этот интервал. Чаще всего берут 95%.' },
  { q: 'Что значит «различие значимо»?', a: 'Что разница между группами вряд ли возникла случайно из-за того, что мы опросили не всех. Значимость не говорит о том, насколько разница важна для бизнеса.' },
  { q: 'Какую долю вводить, если её не знаете?', a: 'Введите 50%. Это самый осторожный вариант: он даёт максимальную выборку и подходит, когда о доле нет предположений.' },
  { q: 'Подходит ли калькулятор для квотной или взвешенной выборки?', a: 'Он рассчитан на простую случайную выборку. При квотах и весах реальная погрешность больше, и её считают отдельно с учётом дизайн-эффекта.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'Сколько людей опросить: калькулятор выборки', item: url },
      ],
    },
    {
      '@type': 'WebApplication',
      '@id': `${url}#app`,
      name: 'Сколько людей опросить: калькулятор выборки',
      url,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Любой, в браузере',
      inLanguage: 'ru',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'RUB' },
      provider: { '@id': `${SITE}/#org` },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};
---
<BaseLayout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <SiteHeader contactHref="#contact" />

  <main class="page page-wide">
    <nav class="breadcrumbs" aria-label="Хлебные крошки">
      <a href="/">Главная</a><span aria-hidden="true">/</span>
      <span aria-current="page">Сколько людей опросить</span>
    </nav>

    <h1>Сколько людей опросить</h1>
    <p class="lead">Ответьте на несколько вопросов о вашем опросе простыми словами. Мы посчитаем, сколько человек нужно в каждой группе и сколько всего, и объясним, почему так. Статистику знать не нужно. Данные не уходят на сервер, всё считается в вашем браузере.</p>

    <section class="pl" aria-labelledby="pl-title">
      <h2 id="pl-title" class="sr-only">Планировщик выборки</h2>

      <div class="pl-step">
        <div class="pl-num">1</div>
        <div class="pl-body">
          <h3>Что вы хотите узнать по итогам опроса?</h3>
          <div class="pl-options">
            <label class="pl-opt"><input type="radio" name="pl-mode" value="all" /><span><b>Общую картину</b><i>Одна аудитория, смотрим общие результаты</i></span></label>
            <label class="pl-opt"><input type="radio" name="pl-mode" value="groups" checked /><span><b>Выводы отдельно по группам</b><i>Например, покупатели и не покупатели, или клиенты из разных городов</i></span></label>
          </div>
        </div>
      </div>

      <div class="pl-step" id="pl-step-groups">
        <div class="pl-num">2</div>
        <div class="pl-body">
          <h3>Какие это группы?</h3>
          <p class="pl-help">Перечислите группы, по каждой из которых нужен отдельный вывод. Если группу нужно разделить ещё на части (например, на два возрастных диапазона), отметьте это в строке группы.</p>
          <div id="pl-groups"></div>
          <button type="button" class="pl-add" id="pl-add">+ Добавить группу</button>
          <div class="pl-cut">
            <label class="field-label" for="pl-cut">Нужно ли в каждой группе смотреть отдельно ещё и по какому-то признаку?</label>
            <select class="field" id="pl-cut">
              <option value="1" selected>Нет, только по группам</option>
              <option value="2">Да, на 2 части (например, мужчины и женщины)</option>
              <option value="3">Да, на 3 части (например, три возраста)</option>
              <option value="4">Да, на 4 части</option>
            </select>
          </div>
        </div>
      </div>

      <div class="pl-step">
        <div class="pl-num">3</div>
        <div class="pl-body">
          <h3>Насколько точными должны быть цифры?</h3>
          <div class="pl-options">
            <label class="pl-opt"><input type="radio" name="pl-err" value="10" /><span><b>Прикинуть картину</b><i>«40% выбрали вариант» значит от 30 до 50%</i></span></label>
            <label class="pl-opt"><input type="radio" name="pl-err" value="5" checked /><span><b>Обычная точность</b><i>«40%» значит от 35 до 45%</i></span></label>
            <label class="pl-opt"><input type="radio" name="pl-err" value="3" /><span><b>Высокая точность</b><i>«40%» значит от 37 до 43%</i></span></label>
          </div>
        </div>
      </div>

      <div class="pl-step" id="pl-step-compare">
        <div class="pl-num">4</div>
        <div class="pl-body">
          <h3>Нужно ли сравнивать группы между собой?</h3>
          <div class="pl-options">
            <label class="pl-opt"><input type="radio" name="pl-compare" value="no" checked /><span><b>Нет</b><i>Достаточно описать каждую группу</i></span></label>
            <label class="pl-opt"><input type="radio" name="pl-compare" value="yes" /><span><b>Да</b><i>Хочу уверенно заметить, где одна группа отличается от другой</i></span></label>
          </div>
          <div class="pl-diff" id="pl-diff-wrap">
            <label class="field-label" for="pl-diff">Какую разницу между группами важно заметить?</label>
            <select class="field" id="pl-diff">
              <option value="5">От 5 п.п. (тонкие различия, нужно много людей)</option>
              <option value="10" selected>От 10 п.п. (заметные различия)</option>
              <option value="15">От 15 п.п.</option>
              <option value="20">От 20 п.п. (только сильные различия)</option>
            </select>
          </div>
        </div>
      </div>

      <div class="pl-result" id="pl-out" role="status" aria-live="polite"></div>
    </section>

    <details class="calc-pro">
      <summary>Если вы знаете статистику: быстрые калькуляторы</summary>
    <div class="calc-grid">
      <section class="calc-card" aria-labelledby="c1">
        <h2 id="c1">Сколько респондентов нужно</h2>
        <div class="calc-fields">
          <div>
            <label class="field-label" for="s-conf">Доверительная вероятность</label>
            <select class="field" id="s-conf"><option value="90">90%</option><option value="95" selected>95%</option><option value="99">99%</option></select>
          </div>
          <div>
            <label class="field-label" for="s-err">Погрешность, ± п.п.</label>
            <input class="field" id="s-err" type="text" inputmode="decimal" value="5" autocomplete="off" />
          </div>
          <div>
            <label class="field-label" for="s-p">Ожидаемая доля, %</label>
            <input class="field" id="s-p" type="text" inputmode="decimal" value="50" autocomplete="off" />
          </div>
          <div>
            <label class="field-label" for="s-pop">Размер аудитории (необязательно)</label>
            <input class="field" id="s-pop" type="text" inputmode="numeric" placeholder="Если большая, оставьте пустым" autocomplete="off" />
          </div>
        </div>
        <div class="calc-result" id="s-out" role="status" aria-live="polite"></div>
      </section>

      <section class="calc-card" aria-labelledby="c2">
        <h2 id="c2">Какая погрешность у выборки</h2>
        <div class="calc-fields">
          <div>
            <label class="field-label" for="e-conf">Доверительная вероятность</label>
            <select class="field" id="e-conf"><option value="90">90%</option><option value="95" selected>95%</option><option value="99">99%</option></select>
          </div>
          <div>
            <label class="field-label" for="e-n">Число респондентов</label>
            <input class="field" id="e-n" type="text" inputmode="numeric" value="400" autocomplete="off" />
          </div>
          <div>
            <label class="field-label" for="e-p">Доля в ответах, %</label>
            <input class="field" id="e-p" type="text" inputmode="decimal" value="50" autocomplete="off" />
          </div>
          <div>
            <label class="field-label" for="e-pop">Размер аудитории (необязательно)</label>
            <input class="field" id="e-pop" type="text" inputmode="numeric" placeholder="Если большая, оставьте пустым" autocomplete="off" />
          </div>
        </div>
        <div class="calc-result" id="e-out" role="status" aria-live="polite"></div>
      </section>

      <section class="calc-card calc-card--wide" aria-labelledby="c3">
        <h2 id="c3">Значимо ли различие двух групп</h2>
        <p class="calc-intro">Например, довольны сервисом 62% клиентов из одного города и 55% из другого. Это разница или случайный разброс?</p>
        <div class="calc-fields calc-fields--diff">
          <div>
            <label class="field-label" for="d-n1">Группа А: респондентов</label>
            <input class="field" id="d-n1" type="text" inputmode="numeric" value="400" autocomplete="off" />
          </div>
          <div>
            <label class="field-label" for="d-p1">Группа А: доля, %</label>
            <input class="field" id="d-p1" type="text" inputmode="decimal" value="62" autocomplete="off" />
          </div>
          <div>
            <label class="field-label" for="d-n2">Группа Б: респондентов</label>
            <input class="field" id="d-n2" type="text" inputmode="numeric" value="400" autocomplete="off" />
          </div>
          <div>
            <label class="field-label" for="d-p2">Группа Б: доля, %</label>
            <input class="field" id="d-p2" type="text" inputmode="decimal" value="55" autocomplete="off" />
          </div>
          <div>
            <label class="field-label" for="d-conf">Доверительная вероятность</label>
            <select class="field" id="d-conf"><option value="90">90%</option><option value="95" selected>95%</option><option value="99">99%</option></select>
          </div>
        </div>
        <div class="calc-result" id="d-out" role="status" aria-live="polite"></div>
      </section>
    </div>

        </details>
<h2>Как считается</h2>
    <p class="calc-formula">n = z² · p · (1 − p) / e²</p>
    <p class="lead">Планировщик выше считает число людей на каждую группу по этой же формуле при доверительной вероятности 95% и доле 50% (самый осторожный вариант), а для сравнения групп берёт мощность 80%. Затем умножает на число групп и добавляет около 10% запаса. В самой формуле z зависит от доверительной вероятности (1,96 для 95%), p — ожидаемая доля, e — допустимая погрешность. Для конечной аудитории размер выборки уменьшается по поправке n / (1 + (n − 1) / N). Значимость различий считаем z-критерием для двух долей. Калькулятор подходит для простой случайной выборки. При квотах и весах погрешность больше, и её считают отдельно. Подробнее: <a href="/blog/kak-rasschitat-vyborku-dlya-oprosa/">как рассчитать выборку для опроса</a>.</p>

    <h2>Частые вопросы</h2>
    <div class="faq">
      {faq.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>

    <p class="article-service-link">Нужно провести опрос и посчитать выборку под вашу задачу? Смотрите <a href="/uslugi/cati-cawi-oprosy/">опросы CATI и CAWI</a> или <a href="#contact">расскажите о задаче</a>.</p>
  </main>

  <ContactBlock
    heading="Нужен расчёт под ваш проект"
    subheading="Подберём метод, выборку и сроки. Цену называем до начала работ."
  />
  <SiteFooter />
  <script is:inline src="/js/planner.js" defer></script>
  <script is:inline src="/js/calc.js" defer></script>
</BaseLayout>

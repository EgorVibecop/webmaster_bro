---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { services } from '../data/services.js';

const process = [
  { title: 'Бриф и методология', desc: 'Обсуждаем задачу, предлагаем метод и выборку, фиксируем сроки и стоимость.' },
  { title: 'Сбор данных', desc: 'CATI/CAWI-опрос, интервью или тестирование по согласованному сценарию.' },
  { title: 'Анализ', desc: 'Считаем статистику, проверяем данные на артефакты выборки, ищем закономерности.' },
  { title: 'Отчёт с рекомендациями', desc: 'Конкретные шаги для бизнеса, а не сырые данные без выводов.' },
];

const SITE = 'https://baikalresearch.ru';
const description = 'Маркетинговые и продуктовые исследования, опросы CATI/CAWI, юзабилити-тестирование и кастдев-интервью. Стратегия и анализ рынка на данных, а не на интуиции.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: `${SITE}/`,
      name: 'Baikal Research',
      inLanguage: 'ru',
      publisher: { '@id': `${SITE}/#org` },
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${SITE}/#org`,
      name: 'Baikal Research',
      url: `${SITE}/`,
      logo: `${SITE}/apple-touch-icon.png`,
      image: `${SITE}/og-image.jpg`,
      description,
      slogan: 'Видим глубже',
      telephone: '+79774437588',
      areaServed: { '@type': 'Country', name: 'Россия' },
      knowsLanguage: 'ru',
      knowsAbout: ['маркетинговые исследования', 'продуктовые исследования', 'опросы CATI и CAWI', 'юзабилити-тестирование', 'кастдев', 'JTBD', 'анализ рынка'],
      contactPoint: { '@type': 'ContactPoint', telephone: '+79774437588', contactType: 'sales', availableLanguage: 'ru' },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Услуги',
        itemListElement: services.map((s) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: s.title, description: s.desc, url: `${SITE}/uslugi/${s.slug}/` },
        })),
      },
    },
  ],
};
---
<BaseLayout
  title="Baikal Research — исследования и бизнес-консалтинг"
  description={description}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <SiteHeader />

  <main>

  <section class="hero">
    <h1>Данные, которые превращаются в стратегию, а не остаются таблицей с цифрами</h1>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#contact">Обсудить задачу</a>
      <a class="btn btn-ghost" href="#process">Как мы работаем</a>
    </div>
  </section>

  <div class="wave-divider">
    <svg width="100%" height="26" viewBox="0 0 1440 26" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 13 Q60 2 120 13 T240 13 T360 13 T480 13 T600 13 T720 13 T840 13 T960 13 T1080 13 T1200 13 T1320 13 T1440 13" fill="none" stroke="var(--accent)" stroke-width="1.5" opacity="0.35"/>
    </svg>
  </div>

  <section id="services" class="services dot-field">
    <div class="section-head">
      <div class="eyebrow">Услуги</div>
      <h2>От стратегии до количественных данных — закрываем вопрос целиком</h2>
      <p>Проводим маркетинговые и продуктовые исследования, опросы, юзабилити-тесты и кастдев-интервью — и отдаём не таблицу с цифрами, а конкретные рекомендации к сроку, о котором договорились на старте.</p>
    </div>
    <div class="svc-list">
      {services.map((s, i) => (
        <a class="svc-row" href={`/uslugi/${s.slug}/`} aria-label={`Подробнее об услуге: ${s.title}`}>
          <div class="svc-index">{String(i + 1).padStart(2, '0')}</div>
          <svg class="svc-icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
          <div class="svc-body">
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
          <svg class="svc-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      ))}
    </div>
  </section>

  <section id="process" class="process">
    <div class="section-head">
      <div class="eyebrow">Процесс</div>
      <h2>Из брифа в решение за понятный срок</h2>
    </div>
    <div class="timeline">
      <div class="timeline-line"></div>
      <div class="timeline-row">
        {process.map((step, i) => (
          <div class="timeline-item">
            <div class="timeline-num">{String(i + 1).padStart(2, '0')}</div>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="approach dot-field">
    <h2>Не продаём объём — предлагаем то, что реально нужно для задачи</h2>
    <p>Не растягиваем исследование до 100 интервью или опроса на 10 000 человек, если задаче хватает меньшего. Метод и размер выборки подбираем под задачу и бюджет, а не подгоняем задачу под прайс.</p>
    <div class="trust-line">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6"/></svg>
      Работаем по стандартам отрасли — ESOMAR, ISO 20252
    </div>
  </section>

  <section id="cases" class="cases">
    <div class="section-head">
      <div class="eyebrow">Как это устроено</div>
      <h2>Не просто цифры — мы смотрим, как люди ведут себя на самом деле</h2>
      <p>Смотрим на проблему клиентскими глазами и сверяем это с аналитикой.</p>
    </div>

    <div class="cases-grid">
      <div id="observation-room" class="observation-room">
        <img class="observation-photo" src="/observation-room.webp" width="1086" height="776" loading="lazy" alt="Комната наблюдения: двое исследователей в наушниках сидят за длинным столом перед односторонним зеркалом, за стеклом модератор беседует с респондентом" />
        <img id="observation-glass" class="observation-glass" src="/observation-glass.webp" width="1086" height="776" alt="" aria-hidden="true" />
        <div class="observation-caption">Комната наблюдения · юзабилити-тест / фокус-группа</div>
      </div>

      <div class="nps-card">
        <div class="nps-scale" role="img" aria-label="NPS вырос с плюс 18 до плюс 42">
          <span class="nps-from">+18</span>
          <svg class="nps-arrow" width="72" height="44" viewBox="0 0 64 40" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h54M42 6l16 14-16 14"/></svg>
          <span class="nps-to">+42</span>
        </div>
        <div class="headline">Так может расти NPS после внедрения рекомендаций из отчёта</div>
        <div class="fine-print">NPS = доля промоутеров (оценки 9–10) минус доля критиков (0–6), шкала от −100 до +100.</div>
      </div>
    </div>
  </section>

  <ContactBlock />

  </main>

  <SiteFooter />

  <script is:inline src="/js/observation-glass.js" defer></script>
</BaseLayout>

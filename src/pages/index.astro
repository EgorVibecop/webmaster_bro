---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { services } from '../data/services.js';
import { tasks } from '../data/tasks.js';

const clients = [
  { name: 'Магнит Tech', file: 'magnit-tech.png' },
  { name: 'Novartis', file: 'novartis.png' },
  { name: 'Национальная Лотерея', file: 'nacionalnaya-loteriya.png', tall: true },
  { name: 'СберЗдоровье', file: 'sberzdorovye.png' },
];

const process = [
  { title: 'Бриф и методология', desc: 'Обсуждаем задачу, предлагаем метод и выборку, фиксируем сроки и стоимость.' },
  { title: 'Сбор данных', desc: 'CATI/CAWI-опрос, интервью или тестирование по согласованному сценарию. Следим за качеством рекрута.' },
  { title: 'Анализ', desc: 'Считаем статистику, проверяем данные на искажения (перекосы выборки, дубли, шаблонные ответы), ищем закономерности.' },
  { title: 'Отчет с рекомендациями', desc: 'Выводы, которые можно внедрить с пользой для бизнеса.' },
];


const SITE = 'https://baikalresearch.ru';
const description = 'Маркетинговые и продуктовые исследования на заказ: исследование рынка, опрос клиентов, глубинные интервью, юзабилити-тестирование. Выводы и рекомендации для ваших решений.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: `${SITE}/`,
      name: 'Baikal Research',
      alternateName: 'Байкал Рисерч',
      inLanguage: 'ru',
      publisher: { '@id': `${SITE}/#org` },
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${SITE}/#org`,
      name: 'Baikal Research',
      alternateName: ['Байкал Рисерч', 'Baikal Research агентство исследований'],
      url: `${SITE}/`,
      sameAs: ['https://yandex.ru/maps/org/baikal_research/159982807852/'],
      logo: `${SITE}/apple-touch-icon.png`,
      image: `${SITE}/og-image.jpg`,
      description,
      slogan: 'Видим глубже',
      telephone: '+79774437588',
      email: 'baikalresearch@yandex.ru',
      areaServed: { '@type': 'Country', name: 'Россия' },
      knowsLanguage: 'ru',
      knowsAbout: ['маркетинговые исследования', 'продуктовые исследования', 'опросы CATI и CAWI', 'юзабилити-тестирование', 'кастдев', 'JTBD', 'анализ рынка'],
      contactPoint: { '@type': 'ContactPoint', telephone: '+79774437588', email: 'baikalresearch@yandex.ru', contactType: 'sales', availableLanguage: 'ru' },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Услуги',
        itemListElement: services.map((s) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: s.title, description: s.desc, url: `${SITE}/uslugi/${s.slug}/` },
        })),
      },
    },
  ],
};
---
<BaseLayout
  title="Baikal Research (Байкал Рисерч) — исследования и бизнес-консалтинг"
  description={description}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <SiteHeader contactHref="#contact" />

  <main>

  <section class="hero">
    <div class="hero-inner">
      <div class="hero-main">
        <h1>Исследования, после которых понятно, что делать</h1>
        <div class="hero-actions">
          <a class="btn btn-on-dark" href="#contact">Обсудить задачу</a>
          <a class="btn btn-ghost-on-dark" href="/kak-my-rabotaem/">Как мы работаем</a>
        </div>
        <p class="hero-offer"><a class="hero-tool" href="/instrumenty/kalkulyator-vyborki/">Бесплатный расчет выборки для опроса <span aria-hidden="true">→</span></a></p>
        <p class="hero-offer hero-offer--second">Скидка 20% на первое исследование. <a href="#contact">Напишите</a> или позвоните: <a href="tel:+79774437588">+7 977 443-75-88</a></p>
      </div>
      <aside class="hero-steps" aria-label="С какой задачей приходят">
        <div class="hero-steps-title">С какой задачей приходят</div>
        <ul>
          {tasks.map((t) => (
            <li>
              <a href={`/uslugi/${t.slug}/`}>
                <b>{t.q}</b>
                <span class="d">{t.service} <span class="arr" aria-hidden="true">→</span></span>
              </a>
            </li>
          ))}
        </ul>
        <a class="hero-steps-link" href="#contact">Другая задача? Опишите ее <span aria-hidden="true">→</span></a>
      </aside>
    </div>
  </section>

  <section id="services" class="services">
    <div class="section-head">
      <div class="eyebrow">Услуги</div>
      <h2>Какие исследования мы проводим</h2>
    </div>
    <div class="svc-list">
      {services.map((s, i) => (
        <a class="svc-row" href={`/uslugi/${s.slug}/`} aria-label={`Подробнее об услуге: ${s.title}`}>
          <div class="svc-index">{String(i + 1).padStart(2, '0')}</div>
          <div class="svc-body">
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
          <span class="svc-more">Подробнее <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
    <a class="section-link" href="/uslugi/">Все услуги и вопросы, с которыми приходят <span aria-hidden="true">→</span></a>
  </section>

  <section id="process" class="process">
    <div class="section-head">
      <div class="eyebrow">Процесс</div>
      <h2>Из брифа в решение за понятный срок</h2>
    </div>
    <div class="timeline">
      <div class="timeline-line"></div>
      <div class="timeline-row">
        {process.map((step, i) => (
          <div class="timeline-item">
            <div class="timeline-num">{String(i + 1).padStart(2, '0')}</div>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
    <a class="section-link" href="/kak-my-rabotaem/">Подробнее о формате взаимодействия <span aria-hidden="true">→</span></a>
  </section>

  <section class="tool-band" aria-labelledby="tool-title">
    <div class="tool-card">
      <div>
        <div class="eyebrow tool-eyebrow">Бесплатный калькулятор выборки</div>
        <h2 id="tool-title">Сколько людей опросить?</h2>
        <p>Опишите группы респондентов и нужную точность простыми словами. Посчитаем, сколько человек нужно, и объясним, почему так. Статистику знать не нужно.</p>
      </div>
      <a class="btn btn-on-dark" href="/instrumenty/kalkulyator-vyborki/">Рассчитать выборку</a>
    </div>
  </section>

  <section class="approach">
    <h2>Подбираем исследование под задачу и бюджет</h2>
    <p>Метод и размер выборки выбираем под задачу и бюджет. Если задаче хватает 10 интервью, мы не предложим 100. Если хватает опроса на 400 человек, не будем делать опрос на 10 000. Так же гибко подходим к формату работы: с юрлицами, ИП и физлицами, с предоплатой, по этапам или после сдачи. Подход к каждому клиенту индивидуальный. Берем и небольшие проекты: работаем с малым бизнесом, ИП и частными лицами.</p>
    <a class="section-link" href="/o-nas/">О нас <span aria-hidden="true">→</span></a>
    <div class="trust-line">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6"/></svg>
      Работаем по стандартам отрасли — ESOMAR, ISO 20252
    </div>
  </section>

  <section id="cases" class="cases">
    <div class="section-head">
      <div class="eyebrow">Как это устроено</div>
      <h2>Изучаем реальное поведение пользователей</h2>
      <p>Наблюдения сверяем с аналитикой, чтобы выводы опирались на оба источника.</p>
    </div>

    <div class="cases-grid">
      <div id="observation-room" class="observation-room">
        <img class="observation-photo" src="/observation-room.webp" width="1086" height="776" loading="lazy" alt="Комната наблюдения: двое исследователей в наушниках сидят за длинным столом перед односторонним зеркалом, за стеклом модератор беседует с респондентом" />
        <img id="observation-glass" class="observation-glass" src="/observation-glass.webp" width="1086" height="776" alt="" aria-hidden="true" />
        <div class="observation-caption">Комната наблюдения · юзабилити-тест / фокус-группа</div>
      </div>

      <div class="nps-card">
        <div class="nps-scale" role="img" aria-label="NPS вырос с плюс 18 до плюс 42">
          <span class="nps-from">+18</span>
          <svg class="nps-arrow" width="72" height="44" viewBox="0 0 64 40" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h54M42 6l16 14-16 14"/></svg>
          <span class="nps-to" data-count-from="18" data-count-to="42" data-prefix="+" data-count-ms="700">+42</span>
        </div>
        <div class="headline">Так может расти NPS после внедрения рекомендаций из отчета</div>
        <div class="fine-print">NPS = доля промоутеров (оценки 9–10) минус доля критиков (0–6), шкала от −100 до +100.</div>
      </div>
    </div>
  </section>

  <section class="clients" aria-label="С кем работали">
    <div class="clients-label">С кем работали</div>
    <ul class="clients-row">
      {clients.map((c) => (
        <li class={c.tall ? 'tall' : undefined}><img src={`/clients/${c.file}`} alt={c.name} height="40" loading="lazy" /></li>
      ))}
    </ul>
  </section>

  <ContactBlock />

  </main>

  <SiteFooter />

  <script is:inline src="/js/observation-glass.js" defer></script>
  <script is:inline src="/js/count-up.js" defer></script>
</BaseLayout>

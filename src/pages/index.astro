---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { FORM_ENDPOINT } from '../config.js';
import { services } from '../data/services.js';

const process = [
  { title: 'Бриф и методология', desc: 'Обсуждаем задачу, предлагаем метод и выборку, фиксируем сроки и стоимость.' },
  { title: 'Сбор данных', desc: 'CATI/CAWI-опрос, интервью или тестирование по согласованному сценарию.' },
  { title: 'Анализ', desc: 'Считаем статистику, проверяем данные на артефакты выборки, ищем закономерности.' },
  { title: 'Отчёт с рекомендациями', desc: 'Конкретные шаги для бизнеса, а не сырые данные без выводов.' },
];

const SITE = 'https://baikalresearch.ru';
const description = 'Маркетинговые и продуктовые исследования, опросы CATI/CAWI, юзабилити-тестирование и кастдев-интервью. Стратегия и анализ рынка на данных, а не на интуиции.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: `${SITE}/`,
      name: 'Baikal Research',
      inLanguage: 'ru',
      publisher: { '@id': `${SITE}/#org` },
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${SITE}/#org`,
      name: 'Baikal Research',
      url: `${SITE}/`,
      logo: `${SITE}/apple-touch-icon.png`,
      image: `${SITE}/og-image.jpg`,
      description,
      slogan: 'Видим глубже',
      telephone: '+79774437588',
      areaServed: { '@type': 'Country', name: 'Россия' },
      knowsLanguage: 'ru',
      knowsAbout: ['маркетинговые исследования', 'продуктовые исследования', 'опросы CATI и CAWI', 'юзабилити-тестирование', 'кастдев', 'JTBD', 'анализ рынка'],
      contactPoint: { '@type': 'ContactPoint', telephone: '+79774437588', contactType: 'sales', availableLanguage: 'ru' },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Услуги',
        itemListElement: services.map((s) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: s.title, description: s.desc, url: `${SITE}/uslugi/${s.slug}/` },
        })),
      },
    },
  ],
};
---
<BaseLayout
  title="Baikal Research — исследования и бизнес-консалтинг"
  description={description}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <SiteHeader />

  <main>

  <section class="hero">
    <h1>Данные, которые превращаются в стратегию, а не остаются таблицей с цифрами</h1>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#contact">Обсудить задачу</a>
      <a class="btn btn-ghost" href="#cases">Смотреть методологию</a>
    </div>
  </section>

  <div class="wave-divider">
    <svg width="100%" height="26" viewBox="0 0 1440 26" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 13 Q60 2 120 13 T240 13 T360 13 T480 13 T600 13 T720 13 T840 13 T960 13 T1080 13 T1200 13 T1320 13 T1440 13" fill="none" stroke="var(--accent)" stroke-width="1.5" opacity="0.35"/>
    </svg>
  </div>

  <section id="services" class="services dot-field">
    <div class="section-head">
      <div class="eyebrow">Услуги</div>
      <h2>От стратегии до количественных данных — закрываем вопрос целиком</h2>
      <p>Проводим маркетинговые и продуктовые исследования, опросы, юзабилити-тесты и кастдев-интервью — и отдаём не таблицу с цифрами, а конкретные рекомендации к сроку, о котором договорились на старте.</p>
    </div>
    <div class="svc-list">
      {services.map((s, i) => (
        <div class="svc-row">
          <div class="svc-index">{String(i + 1).padStart(2, '0')}</div>
          <svg class="svc-icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
          <div class="svc-body">
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
          <a class="svc-link" href={`/uslugi/${s.slug}/`} aria-label={`Подробнее об услуге: ${s.title}`}>Подробнее →</a>
        </div>
      ))}
    </div>
  </section>

  <section id="process" class="process">
    <div class="section-head">
      <div class="eyebrow">Процесс</div>
      <h2>Из брифа в решение за понятный срок</h2>
    </div>
    <div class="timeline">
      <div class="timeline-line"></div>
      <div class="timeline-row">
        {process.map((step, i) => (
          <div class:list={['timeline-item', { 'is-active': i === 0 }]}>
            <div class="timeline-num">{String(i + 1).padStart(2, '0')}</div>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="approach dot-field">
    <h2>Не продаём объём — предлагаем то, что реально нужно для задачи</h2>
    <p>Не растягиваем исследование до 100 интервью или опроса на 10 000 человек, если задаче хватает меньшего. Предлагаем методику и размер выборки исходя из бюджета и того, что нужно узнать, — а не из прайса.</p>
    <div class="trust-line">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6"/></svg>
      Работаем по стандартам отрасли — ESOMAR, ISO 20252
    </div>
  </section>

  <section id="cases" class="cases">
    <div class="section-head">
      <div class="eyebrow">Как это устроено</div>
      <h2>Не просто цифры — мы наблюдаем за реальным поведением</h2>
      <p>Смотрим на бизнес через призму клиента и сверяем это с реальной аналитикой — а не полагаемся на одну сторону.</p>
    </div>

    <div class="cases-grid">
      <div id="observation-room" class="observation-room">
        <img class="observation-photo" src="/observation-room.webp" width="1086" height="776" loading="lazy" alt="Комната наблюдения: двое исследователей в наушниках сидят за длинным столом перед односторонним зеркалом, за стеклом модератор беседует с респондентом" />
        <img id="observation-glass" class="observation-glass" src="/observation-glass.webp" width="1086" height="776" alt="" aria-hidden="true" />
        <div class="observation-caption">Комната наблюдения · юзабилити-тест / фокус-группа</div>
      </div>

      <div class="nps-card">
        <div class="nps-scale" role="img" aria-label="NPS вырос с плюс 18 до плюс 42">
          <span class="nps-from">+18</span>
          <svg class="nps-arrow" width="72" height="44" viewBox="0 0 64 40" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h54M42 6l16 14-16 14"/></svg>
          <span class="nps-to">+42</span>
        </div>
        <div class="headline">Так может расти NPS после внедрения рекомендаций из отчёта</div>
        <div class="fine-print">NPS = доля промоутеров (оценки 9–10) минус доля критиков (0–6), шкала от −100 до +100.</div>
      </div>
    </div>
  </section>

  <section id="contact" class="contact">
    <div class="contact-grid">
      <div class="contact-form-col">
        <div>
          <div class="eyebrow">Контакты</div>
          <h2>Расскажите о задаче — предложим метод и сроки</h2>
        </div>
        <form class="form-grid" id="lead-form" name="brief" data-endpoint={FORM_ENDPOINT}>
          <div>
            <label class="field-label" for="f-name">Имя <span class="req">*</span></label>
            <input class="field" id="f-name" name="name" type="text" autocomplete="name" maxlength="100" placeholder="Как к вам обращаться" required />
          </div>
          <div>
            <label class="field-label" for="f-company">Компания</label>
            <input class="field" id="f-company" name="company" type="text" autocomplete="organization" maxlength="150" placeholder="Название компании" />
          </div>
          <div>
            <label class="field-label" for="f-email">Email <span class="req">*</span></label>
            <input class="field" id="f-email" name="email" type="email" autocomplete="email" maxlength="150" placeholder="you@company.ru" required />
          </div>
          <div>
            <label class="field-label" for="f-phone">Телефон</label>
            <input class="field" id="f-phone" name="phone" type="tel" autocomplete="tel" maxlength="50" placeholder="+7 (___) ___-__-__" />
          </div>
          <div class="full">
            <label class="field-label" for="f-service">Тип услуги</label>
            <select class="field" id="f-service" name="service">
              <option>Маркетинговое исследование</option>
              <option>Продуктовое исследование</option>
              <option>Опрос CATI / CAWI</option>
              <option>Юзабилити-тестирование</option>
              <option>Кастдев-интервью</option>
              <option>Пока не знаю, нужна консультация</option>
            </select>
          </div>
          <div class="full">
            <label class="field-label" for="f-message">Коротко о задаче</label>
            <textarea class="field" id="f-message" name="message" rows="4" maxlength="2000" placeholder="Что нужно узнать и к какому сроку"></textarea>
          </div>
          <div class="hp" aria-hidden="true">
            <label>Не заполняйте это поле <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <div class="full">
            <label class="consent">
              <input type="checkbox" name="consent" required />
              <span>Даю согласие на обработку персональных данных в соответствии с <a href="/privacy/" target="_blank" rel="noopener">Политикой обработки персональных данных</a> <span class="req">*</span></span>
            </label>
          </div>
          <div class="full submit-row">
            <button class="btn btn-primary" type="submit">Обсудить задачу</button>
            <div class="required-note"><span class="req">*</span> — обязательные поля, остальное по желанию</div>
          </div>
          <div class="full form-status" id="form-status" role="status" aria-live="polite"></div>
        </form>
      </div>

      <div class="contact-card">
        <div>
          <div class="label">Телефон</div>
          <a class="phone-link" href="tel:+79774437588">+7 977 443-75-88</a>
        </div>
        <div class="divider"></div>
        <div>
          <div class="label">Email</div>
          <div class="value">[email@baikalresearch.ru]</div>
        </div>
        <div class="divider"></div>
        <div>
          <div class="label">Telegram</div>
          <a class="value" href="https://t.me/wowtsap" target="_blank" rel="noopener">@wowtsap</a>
        </div>
        <div class="divider"></div>
        <div>
          <div class="label">Город</div>
          <div class="value">[Город]</div>
        </div>
        <div class="fine-print">Отвечаем на заявки в течение одного рабочего дня.</div>
      </div>
    </div>
  </section>

  </main>

  <SiteFooter />

  <script is:inline src="/js/observation-glass.js" defer></script>
  <script is:inline src="/js/lead-form.js" defer></script>
</BaseLayout>

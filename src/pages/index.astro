---
import { ASSET_V } from '../config.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { services } from '../data/services.js';
import { clients } from '../data/clients.js';


const dive = [
  { depth: '0 м', m: 0, title: 'Брифинг' },
  { depth: '120 м', m: 120, title: 'Сбор данных' },
  { depth: '600 м', m: 600, title: 'Анализ' },
  { depth: '1 642 м', m: 1642, title: 'Презентация отчета и внедрение результатов' },
];


// Версия картинок первого экрана: должна совпадать с VER в scripts/build-hero.cjs (имя файла меняется, чтобы браузер не держал старую картинку).
const HERO_V = 'v5';
const SITE = 'https://baikalresearch.ru';
const description = 'Исследование рынка и конкурентов, опросы, кастдевы, глубинные интервью и юзабилити-тесты. Проводим исследования полного цикла и даем рабочие рекомендации.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: `${SITE}/`,
      name: 'Baikal Research',
      alternateName: 'Байкал Рисерч',
      inLanguage: 'ru',
      publisher: { '@id': `${SITE}/#org` },
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${SITE}/#org`,
      name: 'Baikal Research',
      alternateName: ['Байкал Рисерч', 'Baikal Research агентство исследований'],
      url: `${SITE}/`,
      sameAs: ['https://yandex.ru/maps/org/baikal_research/159982807852/'],
      logo: `${SITE}/apple-touch-icon.png`,
      image: `${SITE}/og-image-v2.jpg`,
      description,
      slogan: 'Видим глубже',
      telephone: '+79774437588',
      email: 'info@baikalresearch.ru',
      areaServed: { '@type': 'Country', name: 'Россия' },
      knowsLanguage: 'ru',
      knowsAbout: ['маркетинговые исследования', 'продуктовые исследования', 'опросы CATI и CAWI', 'юзабилити-тестирование', 'кастдев', 'JTBD', 'анализ рынка'],
      contactPoint: { '@type': 'ContactPoint', telephone: '+79774437588', email: 'info@baikalresearch.ru', contactType: 'sales', availableLanguage: 'ru' },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Услуги',
        itemListElement: services.map((s) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: s.title, description: s.desc, url: `${SITE}/uslugi/${s.slug}/` },
        })),
      },
    },
  ],
};
---
<BaseLayout
  title="Маркетинговые исследования на заказ – Baikal Research (Байкал Рисерч)"
  description={description}
>
  <script slot="head" is:inline src={`/js/hero-time.js?v=${ASSET_V}`} data-v={HERO_V}></script>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <SiteHeader contactHref="#contact" />

  <main>

  <section class="hero-ice" aria-label="Baikal Research">
    <div class="hero-ice-bg" data-anim>
      <picture class="hero-pic hero-pic-day">
        <source media="(max-width: 700px)" srcset={`/hero/day-m-${HERO_V}.webp`} type="image/webp" />
        <source srcset={`/hero/day-d-${HERO_V}.avif`} type="image/avif" />
        <img src={`/hero/day-d-${HERO_V}.webp`} alt="Байкальский лед с трещинами и пузырьками уходит вглубь, над ним заснеженные горы днем" width="2400" height="1502" loading="lazy" fetchpriority="high" decoding="async" />
      </picture>
      <picture class="hero-pic hero-pic-night">
        <source media="(max-width: 700px)" srcset={`/hero/night-m-${HERO_V}.webp`} type="image/webp" />
        <source srcset={`/hero/night-d-${HERO_V}.avif`} type="image/avif" />
        <img src={`/hero/night-d-${HERO_V}.webp`} alt="Байкальский лед с трещинами уходит вглубь, над заснеженными горами звездное небо" width="2400" height="1502" loading="lazy" fetchpriority="high" decoding="async" />
      </picture>
    </div>
    <div class="hero-ice-tint" data-anim></div>
    <div class="hero-ice-shade" aria-hidden="true"></div>
    <div class="hero-ice-content">
      <h1>
        <span class="hl">Исследуем рынок</span>
        <span class="hl">Говорим с пользователями</span>
        <span class="hl">Находим решения</span>
      </h1>
      <div class="hero-actions">
        <a class="btn btn-on-dark" href="#contact">Связаться с нами</a>      </div>
    </div>
    <div class="hero-ice-offer">Скидка 20% на первое исследование</div>
  </section>

  <section id="services" class="services">
    <div class="section-head">
      <h2>Какие исследования проводим</h2>
    </div>
    <div class="svc-list">
      {services.map((s, i) => (
        <a class="svc-row" href={`/uslugi/${s.slug}/`} aria-label={`Подробнее об услуге: ${s.title}`}>
          <div class="svc-body">
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
          <span class="svc-more">Подробнее <span aria-hidden="true"><svg class="ar" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span></span>
        </a>
      ))}
    </div>
  </section>

  <section id="process" class="dive" aria-labelledby="dive-title">
    <div class="dive-wrap">
      <div class="dive-side">
        <h2 class="dive-eyebrow" id="dive-title">Глубина погружения</h2>
        <div class="dive-depth" aria-hidden="true"><span id="dive-num">1 642</span><small>м</small></div>
        <p class="dive-fact">Байкал – самое глубокое озеро планеты. Мы проводим deep dive – собираем не поверхностные выводы, а глубокую аналитику.</p>
      </div>
      <div class="dive-track">
      <div class="dive-rail" aria-hidden="true"><span class="dive-fill"></span><span class="dive-probe"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><circle cx="8" cy="8" r="2"/><path d="M5 13 L3 16"/><path d="M11 13 L13 16"/></svg></span></div>
      <ol class="dive-steps">
        {dive.map((step, i) => (
          <li class="dive-step" data-m={step.m}>
            <span class="dive-dot" aria-hidden="true">{i + 1}</span>
            <div class="dive-meta">{step.depth}</div>
            <h3>{step.title}</h3>
          </li>
        ))}
      </ol>
      </div>
    </div>
  </section>

  <section id="cases" class="cases" aria-label="Исследования с участием пользователей">
    <div class="cases-grid">
      <div id="observation-room" class="observation-room">
        <img class="observation-photo" src="/observation-room-v2.webp" width="1086" height="776" loading="lazy" alt="Комната наблюдения: двое исследователей в наушниках сидят за длинным столом перед односторонним зеркалом, за стеклом модератор беседует с респондентом" />
        <img id="observation-glass" class="observation-glass" src="/observation-glass.webp" width="1086" height="776" alt="" aria-hidden="true" />
        <div class="observation-caption">Открыто говорим с пользователем</div>
      </div>

      <div class="nps-card">
        <div class="nps-scale" role="img" aria-label="Проведено 74 исследования">
          <span class="nps-to" data-count-from="0" data-count-to="74" data-count-ms="1600">74</span>
        </div>
        <div class="headline">исследования проведено</div>
      </div>
    </div>
  </section>

  <section class="clients" aria-label="Клиенты и партнеры">
    <div class="clients-label">Клиенты и партнеры</div>
    <ul class="clients-row">
      {clients.map((c) => {
        const r = c.w / c.h;
        let h = Math.sqrt(5200 / r), w = h * r;
        if (w > 170) { w = 170; h = w / r; }
        if (h > 56) { h = 56; w = h * r; }
        return (
          <li class={c.opaque ? 'opaque' : undefined}>
            <img src={`/clients/${c.file}`} alt={c.name} width={Math.round(w)} height={Math.round(h)} loading="lazy" decoding="async" />
          </li>
        );
      })}
    </ul>
  </section>

  <ContactBlock hideDeadline />

  </main>

  <SiteFooter />

  <script is:inline src={`/js/observation-glass.js?v=${ASSET_V}`} defer></script>
  <script is:inline src={`/js/count-up.js?v=${ASSET_V}`} defer></script>
  <script is:inline src={`/js/dive.js?v=${ASSET_V}`} defer></script>
</BaseLayout>

---
import { ASSET_V } from '../config.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { services } from '../data/services.js';

const clients = [
  { name: 'Магнит Tech', file: 'magnit-tech.png', w: 279, h: 96 },
  { name: 'Novartis', file: 'novartis.png', w: 586, h: 96 },
  { name: 'Национальная Лотерея', file: 'nacionalnaya-loteriya.png', w: 293, h: 110, tall: true },
  { name: 'Промышленно-энергетический форум', file: 'promyshlenno-energeticheskiy-forum.png', w: 187, h: 110, tall: true },
  { name: 'СберЗдоровье', file: 'sberzdorovye.png', w: 342, h: 96 },
];

const process = [
  { title: 'Бриф и методология', desc: 'Обсуждаем задачу, предлагаем метод и выборку, фиксируем сроки и стоимость.' },
  { title: 'Сбор данных', desc: 'CATI/CAWI-опрос, интервью или тестирование по согласованному сценарию. Следим за качеством рекрута.' },
  { title: 'Анализ', desc: 'В опросах считаем статистику и проверяем данные на искажения, в интервью выделяем причины и барьеры. Находим закономерности.' },
  { title: 'Отчет с рекомендациями', desc: 'Выводы, которые можно внедрить с пользой для бизнеса.' },
];


const SITE = 'https://baikalresearch.ru';
const description = 'Маркетинговые и продуктовые исследования: исследование рынка, опрос клиентов, глубинные интервью, юзабилити-тесты. Выводы и рекомендации для решений.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      url: `${SITE}/`,
      name: 'Baikal Research',
      alternateName: 'Байкал Рисерч',
      inLanguage: 'ru',
      publisher: { '@id': `${SITE}/#org` },
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${SITE}/#org`,
      name: 'Baikal Research',
      alternateName: ['Байкал Рисерч', 'Baikal Research агентство исследований'],
      url: `${SITE}/`,
      sameAs: ['https://yandex.ru/maps/org/baikal_research/159982807852/'],
      logo: `${SITE}/apple-touch-icon.png`,
      image: `${SITE}/og-image-v2.jpg`,
      description,
      slogan: 'Видим глубже',
      telephone: '+79774437588',
      email: 'info@baikalresearch.ru',
      areaServed: { '@type': 'Country', name: 'Россия' },
      knowsLanguage: 'ru',
      knowsAbout: ['маркетинговые исследования', 'продуктовые исследования', 'опросы CATI и CAWI', 'юзабилити-тестирование', 'кастдев', 'JTBD', 'анализ рынка'],
      contactPoint: { '@type': 'ContactPoint', telephone: '+79774437588', email: 'info@baikalresearch.ru', contactType: 'sales', availableLanguage: 'ru' },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Услуги',
        itemListElement: services.map((s) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: s.title, description: s.desc, url: `${SITE}/uslugi/${s.slug}/` },
        })),
      },
    },
  ],
};
---
<BaseLayout
  title="Baikal Research (Байкал Рисерч) – исследования и бизнес-консалтинг"
  description={description}
>
  <link slot="head" rel="preload" as="image" href="/hero/ice-m.webp" type="image/webp" media="(max-width: 700px)" fetchpriority="high" />
  <link slot="head" rel="preload" as="image" href="/hero/ice.avif" type="image/avif" media="(min-width: 701px)" fetchpriority="high" />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <SiteHeader contactHref="#contact" />

  <main>

  <section class="hero-ice" aria-label="Baikal Research">
    <div class="hero-ice-bg" data-anim>
      <picture>
        <source media="(max-width: 700px)" srcset="/hero/ice-m.webp" type="image/webp" />
        <source srcset="/hero/ice.avif" type="image/avif" />
        <img src="/hero/ice.webp" alt="Прозрачный байкальский лед с трещинами и пузырьками уходит вглубь, на горизонте заснеженный мыс" width="1585" height="992" fetchpriority="high" decoding="async" />
      </picture>
    </div>
    <div class="hero-ice-tint" data-anim></div>
    <div class="hero-ice-shade" aria-hidden="true"></div>
    <div class="hero-ice-content">
      <h1>
        <span class="hl">Исследуем рынок</span>
        <span class="hl">Говорим с пользователями</span>
        <span class="hl">Находим решения</span>
      </h1>
      <div class="hero-actions">
        <a class="btn btn-on-dark" href="#contact">Связаться с нами</a>
        <a class="btn btn-ghost-on-dark" href="/kak-my-rabotaem/">Как мы работаем</a>
      </div>
    </div>
    <div class="hero-ice-offer">Скидка 20% на первое исследование</div>
  </section>

  <section id="services" class="services">
    <div class="section-head">
      <h2>Какие исследования мы проводим</h2>
    </div>
    <div class="svc-list">
      {services.map((s, i) => (
        <a class="svc-row" href={`/uslugi/${s.slug}/`} aria-label={`Подробнее об услуге: ${s.title}`}>
          <div class="svc-body">
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
          <span class="svc-more">Подробнее <span aria-hidden="true"><svg class="ar" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span></span>
        </a>
      ))}
    </div>
  </section>

  <section id="process" class="process">
    <div class="section-head">
      <h2>Из брифа в решение за понятный срок</h2>
    </div>
    <div class="timeline">
      <div class="timeline-line"></div>
      <div class="timeline-row">
        {process.map((step, i) => (
          <div class="timeline-item">
            <div class="timeline-num">{String(i + 1).padStart(2, '0')}</div>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
    <a class="section-link" href="/kak-my-rabotaem/">Подробнее о формате взаимодействия <span aria-hidden="true"><svg class="ar" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span></a>
  </section>

  <section class="tool-band" aria-labelledby="tool-title">
    <div class="tool-card">
      <div>
        <div class="eyebrow tool-eyebrow">Бесплатный калькулятор выборки</div>
        <h2 id="tool-title">Сколько людей опросить?</h2>
        <p>Опишите группы респондентов и нужную точность простыми словами. Расчет выборки: посчитаем, сколько человек нужно, и объясним, почему так. Статистику знать не нужно.</p>
      </div>
      <a class="btn btn-on-dark" href="/instrumenty/kalkulyator-vyborki/">Рассчитать выборку</a>
    </div>
  </section>

  <section class="approach">
    <h2>Подбираем исследование под задачу и бюджет</h2>
    <p>Метод и размер выборки зависят от цели исследования. Для проверки гипотезы часто хватает 10 интервью, для оценки доли хватает опроса на 400 человек. Работаем с юрлицами, ИП и физлицами, берем и небольшие проекты. Оплату согласуем индивидуально: предоплата, по этапам или после сдачи.</p>
    <a class="section-link" href="/o-nas/">О нас <span aria-hidden="true"><svg class="ar" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span></a>
  </section>

  <section id="cases" class="cases">
    <div class="section-head">
      <h2>Изучаем поведение пользователей</h2>
      <p>Наблюдения сверяем с аналитикой, чтобы выводы опирались на оба источника.</p>
    </div>

    <div class="cases-grid">
      <div id="observation-room" class="observation-room">
        <img class="observation-photo" src="/observation-room.webp" width="1086" height="776" loading="lazy" alt="Комната наблюдения: двое исследователей в наушниках сидят за длинным столом перед односторонним зеркалом, за стеклом модератор беседует с респондентом" />
        <img id="observation-glass" class="observation-glass" src="/observation-glass.webp" width="1086" height="776" alt="" aria-hidden="true" />
      </div>

      <div class="nps-card">
        <div class="nps-scale" role="img" aria-label="NPS вырос с плюс 18 до плюс 42">
          <span class="nps-from">+18</span>
          <svg class="nps-arrow" width="72" height="44" viewBox="0 0 64 40" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h54M42 6l16 14-16 14"/></svg>
          <span class="nps-to" data-count-from="18" data-count-to="42" data-prefix="+" data-count-ms="700">+42</span>
        </div>
        <div class="headline">Так может расти NPS после внедрения рекомендаций из отчета</div>
        <div class="fine-print">NPS = доля промоутеров (оценки 9–10) минус доля критиков (0–6), шкала от −100 до +100.</div>
      </div>
    </div>
  </section>

  <section class="clients" aria-label="Клиенты и партнеры">
    <div class="clients-label">Клиенты и партнеры</div>
    <div class="marquee">
      <div class="marquee-track">
        {[0, 1].map((g) => (
          <ul class="marquee-group" aria-hidden={g === 1 ? 'true' : undefined}>
            {Array.from({ length: 3 }, () => clients).flat().map((c, i) => (
              <li class={[c.tall ? 'tall' : '', i >= clients.length ? 'dup' : ''].join(' ').trim() || undefined}>
                <img src={`/clients/${c.file}`} alt={g === 0 && i < clients.length ? c.name : ''} width={c.w} height={c.h} decoding="async" />
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </section>

  <ContactBlock />

  </main>

  <SiteFooter />

  <script is:inline src={`/js/observation-glass.js?v=${ASSET_V}`} defer></script>
  <script is:inline src={`/js/count-up.js?v=${ASSET_V}`} defer></script>
</BaseLayout>

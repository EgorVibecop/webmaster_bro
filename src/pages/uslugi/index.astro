---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import { services } from '../../data/services.js';

const SITE = 'https://baikalresearch.ru';
const url = `${SITE}/uslugi/`;
const description = 'Маркетинговые и продуктовые исследования, анализ рынка и конкурентов, опросы CATI/CAWI, глубинные интервью и кастдев, юзабилити-тесты. Метод под задачу.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'Услуги', item: url },
      ],
    },
    {
      '@type': 'CollectionPage',
      '@id': `${url}#page`,
      url,
      name: 'Услуги Baikal Research',
      isPartOf: { '@id': `${SITE}/#website` },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: services.map((s, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          url: `${SITE}/uslugi/${s.slug}/`,
          name: s.title,
        })),
      },
    },
  ],
};
---
<BaseLayout title="Услуги – Baikal Research" description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <SiteHeader />

  <main class="page page-wide">
    <nav class="breadcrumbs" aria-label="Хлебные крошки">
      <a href="/">Главная</a><span aria-hidden="true">/</span>
      <span aria-current="page">Услуги</span>
    </nav>

    <h1>Услуги</h1>
    <p class="lead">Исследования под задачу бизнеса: от оценки рынка до проверки интерфейса.</p>

    <div class="svc-cards">
      {services.map((s) => (
        <article class="svc-card">
          <h2><a href={`/uslugi/${s.slug}/`}>{s.title}</a></h2>
          <p class="svc-card-lead">{s.page.lead}</p>
          <div class="svc-card-cols">
            <div>
              <h3>Когда нужно</h3>
              <ul>{s.page.when.slice(0, 3).map((w) => <li>{w}</li>)}</ul>
            </div>
            <div>
              <h3>Что получаете</h3>
              <ul>{s.page.deliverables.slice(0, 3).map((d) => <li>{d}</li>)}</ul>
            </div>
          </div>
          <a class="svc-card-link" href={`/uslugi/${s.slug}/`} aria-label={`Подробнее об услуге: ${s.title}`}>Подробнее об услуге <span aria-hidden="true"><svg class="ar" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span></a>
        </article>
      ))}
    </div>
  </main>

  <ContactBlock
    heading="Расскажите о задаче"
    subheading="Предложим метод, выборку и сроки под вашу задачу и бюджет."
  />
  <SiteFooter />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import ServiceArt from '../../components/ServiceArt.astro';
import { services } from '../../data/services.js';

const SITE = 'https://baikalresearch.ru';
const url = `${SITE}/uslugi/`;
const description = 'Маркетинговые и продуктовые исследования, анализ рынка и конкурентов, опросы CATI/CAWI, глубинные интервью и кастдев, юзабилити-тесты. Метод под задачу.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'Услуги', item: url },
      ],
    },
    {
      '@type': 'CollectionPage',
      '@id': `${url}#page`,
      url,
      name: 'Услуги Baikal Research',
      isPartOf: { '@id': `${SITE}/#website` },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: services.map((s, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          url: `${SITE}/uslugi/${s.slug}/`,
          name: s.title,
        })),
      },
    },
  ],
};
---
<BaseLayout title="Услуги – Baikal Research" description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <SiteHeader />

  <main class="page page-wide">
    <nav class="breadcrumbs" aria-label="Хлебные крошки">
      <a href="/">Главная</a><span aria-hidden="true">/</span>
      <span aria-current="page">Услуги</span>
    </nav>

    <h1 class="sr-only">Услуги</h1>

    <div class="svc-cards">
      {services.map((s) => (
        <a class="svc-card" href={`/uslugi/${s.slug}/`}>
          <h2>{s.title}</h2>
          <div class="svc-card-art"><ServiceArt slug={s.slug} /></div>
        </a>
      ))}
    </div>
  </main>

  <ContactBlock
    heading="Расскажите о задаче"
    subheading="Предложим метод, выборку и сроки под вашу задачу и бюджет."
  />
  <SiteFooter />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getCollection } from 'astro:content';
import { services } from '../../data/services.js';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const { page } = service;

const SITE = 'https://baikalresearch.ru';
const url = `${SITE}/uslugi/${service.slug}/`;
const others = services.filter((s) => s.slug !== service.slug);
const posts = (await getCollection('blog'))
  .filter((p) => p.data.service === service.slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'Услуги', item: `${SITE}/#services` },
        { '@type': 'ListItem', position: 3, name: page.h1, item: url },
      ],
    },
    {
      '@type': 'Service',
      '@id': `${url}#service`,
      name: page.h1,
      serviceType: service.title,
      description: page.metaDescription,
      url,
      provider: { '@id': `${SITE}/#org` },
      areaServed: { '@type': 'Country', name: 'Россия' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: page.faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};
---
<BaseLayout title={page.metaTitle} description={page.metaDescription}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <SiteHeader />

  <main class="page">
    <nav class="breadcrumbs" aria-label="Хлебные крошки">
      <a href="/">Главная</a><span aria-hidden="true">/</span>
      <a href="/#services">Услуги</a><span aria-hidden="true">/</span>
      <span aria-current="page">{service.title}</span>
    </nav>

    <h1>{page.h1}</h1>
    <p class="lead">{page.lead}</p>
    <div class="page-actions">
      <a class="btn btn-primary" href="/#contact">Обсудить задачу</a>
    </div>

    <h2>Когда это нужно</h2>
    <ul class="checks">
      {page.when.map((item) => <li>{item}</li>)}
    </ul>

    <h2>Как проходит работа</h2>
    <ol class="steps">
      {page.steps.map((step) => (
        <li>
          <div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        </li>
      ))}
    </ol>

    {page.note && (
      <aside class="callout">
        <h3>{page.note.title}</h3>
        <p>{page.note.text}</p>
      </aside>
    )}

    <h2>Что вы получите</h2>
    <ul class="checks">
      {page.deliverables.map((item) => <li>{item}</li>)}
    </ul>

    <h2>Частые вопросы</h2>
    <div class="faq">
      {page.faq.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>

    <section class="cta-band" aria-labelledby="cta-title">
      <div>
        <h2 id="cta-title">Расскажите о задаче</h2>
        <p>Предложим метод, выборку и сроки под вашу задачу и бюджет. Цену называем до начала работ.</p>
      </div>
      <a class="btn btn-primary" href="/#contact">Обсудить задачу</a>
    </section>

    {posts.length > 0 && (
      <>
        <h2>Полезные статьи</h2>
        <div class="post-list">
          {posts.map((p) => (
            <article class="post-card">
              <h3><a href={`/blog/${p.slug}/`}>{p.data.title}</a></h3>
              <p>{p.data.description}</p>
            </article>
          ))}
        </div>
      </>
    )}

    <h2>Другие услуги</h2>
    <nav class="related" aria-label="Другие услуги">
      {others.map((s) => <a href={`/uslugi/${s.slug}/`}>{s.title}</a>)}
    </nav>
  </main>

  <SiteFooter />
</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { bySlug } from '../../data/services.js';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const { data } = post;

const SITE = 'https://baikalresearch.ru';
const url = `${SITE}/blog/${post.slug}/`;
const fmt = (d: Date) => d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
const minutes = Math.max(1, Math.round(post.body.split(/\s+/).length / 200));
const withBrand = `${data.title} — Baikal Research`;
const pageTitle = withBrand.length <= 65 ? withBrand : data.title;
const service = data.service ? bySlug(data.service) : undefined;

const all = (await getCollection('blog')).filter((p) => p.slug !== post.slug);
const related = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);

const graph: any[] = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Блог', item: `${SITE}/blog/` },
      { '@type': 'ListItem', position: 3, name: data.title, item: url },
    ],
  },
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    headline: data.title,
    description: data.description,
    inLanguage: 'ru',
    datePublished: data.date.toISOString(),
    dateModified: (data.updated ?? data.date).toISOString(),
    mainEntityOfPage: url,
    image: `${SITE}/og-image.jpg`,
    author: { '@id': `${SITE}/#org` },
    publisher: { '@id': `${SITE}/#org` },
  },
];
if (data.faq.length) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: data.faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  });
}
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---
<BaseLayout
  title={pageTitle}
  description={data.description}
  ogType="article"
  publishedTime={data.date.toISOString()}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <SiteHeader />

  <main class="page article">
    <nav class="breadcrumbs" aria-label="Хлебные крошки">
      <a href="/">Главная</a><span aria-hidden="true">/</span>
      <a href="/blog/">Блог</a><span aria-hidden="true">/</span>
      <span aria-current="page">{data.title}</span>
    </nav>

    <h1>{data.title}</h1>
    <div class="post-meta">
      <time datetime={data.date.toISOString()}>{fmt(data.date)}</time>
      <span aria-hidden="true">·</span>
      <span>{minutes} мин чтения</span>
    </div>

    <div class="prose">
      <Content />
    </div>

    {data.faq.length > 0 && (
      <>
        <h2>Частые вопросы</h2>
        <div class="faq">
          {data.faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </>
    )}

    <section class="cta-band" aria-labelledby="cta-title">
      <div>
        <h2 id="cta-title">{service ? service.title : 'Расскажите о задаче'}</h2>
        <p>Предложим метод, выборку и сроки под вашу задачу и бюджет. Цену называем до начала работ.</p>
      </div>
      <a class="btn btn-primary" href={service ? `/uslugi/${service.slug}/` : '/#contact'}>{service ? 'Подробнее об услуге' : 'Обсудить задачу'}</a>
    </section>

    {related.length > 0 && (
      <>
        <h2>Читайте также</h2>
        <div class="post-list">
          {related.map((p) => (
            <article class="post-card">
              <h3><a href={`/blog/${p.slug}/`}>{p.data.title}</a></h3>
              <p>{p.data.description}</p>
            </article>
          ))}
        </div>
      </>
    )}
  </main>

  <SiteFooter />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactBlock from '../components/ContactBlock.astro';

const SITE = 'https://baikalresearch.ru';
const url = `${SITE}/kak-my-rabotaem/`;
const description = 'Как проходит исследование в Baikal Research: бриф и методология, сбор данных, анализ, отчет с рекомендациями.';

const steps = [
  {
    title: 'Бриф и методология',
    text: 'Обсуждаем задачу, что вам нужно узнать и что уже известно. Предлагаем метод и выборку, фиксируем сроки и стоимость.',
  },
  {
    title: 'Сбор данных',
    text: 'CATI/CAWI-опрос, интервью или юзабилити-тестирование по согласованному сценарию. Рекрутируем респондентов из вашей аудитории, следим за квотами и качеством ответов, не допускаем «профессиональных респондентов».',
  },
  {
    title: 'Анализ',
    text: 'Обрабатываем данные и ищем закономерности. В опросах считаем статистику, проверяем данные на искажения (перекосы выборки, дубли, шаблонные и слишком быстрые ответы) и значимость различий между сегментами. В интервью выделяем причины и барьеры.',
  },
  {
    title: 'Отчет с рекомендациями',
    text: 'Показываем, что делать в первую очередь, и объясняем, на каких данных и с какими ограничениями получены выводы.',
  },
];

const faq = [
  { q: 'С чего начать, если задача сформулирована расплывчато?', a: 'Расскажите, что происходит в бизнесе и что вы хотите понять. Если задача не оформлена, поможем превратить ее в бриф: цели, вопросы исследования, аудитории.' },
  { q: 'Что такое бриф?', a: 'Бриф – это короткий документ о задаче: контекст, что уже известно, цель бизнеса, цель исследования, аудитория, срок и бюджет.' },
  { q: 'Когда я узнаю стоимость?', a: 'До начала работ. Цена зависит от метода, размера выборки и сложности аудитории, поэтому мы называем ее после обсуждения задачи и фиксируем в предложении.' },
  { q: 'Можно ли обойтись без большого исследования?', a: 'Обычно можно: часто хватает нескольких интервью или анализа открытых данных.' },
  { q: 'С кем и на каких условиях вы работаете?', a: 'С юридическими лицами, индивидуальными предпринимателями и физическими лицами. Формат договора и оплаты (предоплата, оплата по этапам или после сдачи работы) согласуем индивидуально.' },
  { q: 'Как вы обращаетесь с данными и можно ли подписать NDA?', a: 'Подписываем соглашение о неразглашении по запросу. Данные респондентов не передаем третьим лицам, а материалы исследования не публикуем без вашего согласия.' },
  { q: 'Как быстро вы отвечаете на заявку?', a: 'В течение одного рабочего дня.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'Как мы работаем', item: url },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};
---
<BaseLayout title="Как мы работаем – Baikal Research" description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <SiteHeader contactHref="#contact" />

  <main class="page">
    <nav class="breadcrumbs" aria-label="Хлебные крошки">
      <a href="/">Главная</a><span aria-hidden="true">/</span>
      <span aria-current="page">Как мы работаем</span>
    </nav>

    <h1>Как мы работаем</h1>
    <p class="lead">Четыре шага: от первого разговора до отчета с выводами и рекомендациями.</p>

    <h2>Процесс исследования</h2>
    <ol class="steps">
      {steps.map((step) => (
        <li>
          <div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        </li>
      ))}
    </ol>

    <aside class="callout">
      <h3>Объем под вашу задачу</h3>
      <p>Размер выборки и число интервью подбираем под цели и задачи исследования. Интервью проводим, пока они дают новые инсайты, а выборку в опросе считаем от нужной точности. Дополнительные респонденты сверх этого только увеличивают стоимость.</p>
    </aside>

    <h2>Что понадобится для старта</h2>
    <ul class="checks">
      <li>Контекст: чем занимается компания и на каком этапе продукт.</li>
      <li>Что уже известно: данные, прошлые исследования, гипотезы.</li>
      <li>Цель бизнеса: как вы хотите применить результат и какие метрики вырастить.</li>
      <li>Кого нужно изучить: целевая аудитория и ограничения по ней.</li>
      <li>Срок и ориентир по бюджету.</li>
    </ul>
    <p class="article-service-link">Если чего-то из списка нет, это нормально: подскажем, как сформулировать. Подробнее о методах в <a href="/blog/kachestvennye-i-kolichestvennye-issledovaniya/">статье о качественных и количественных исследованиях</a>.</p>

    <h2>Частые вопросы</h2>
    <div class="faq">
      {faq.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </main>

  <ContactBlock
    heading="Расскажите о задаче"
    subheading="Предложим метод, выборку и сроки под вашу задачу и бюджет."
  />
  <SiteFooter />
</BaseLayout>

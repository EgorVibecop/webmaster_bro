---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactBlock from '../components/ContactBlock.astro';

const SITE = 'https://baikalresearch.ru';
const url = `${SITE}/kak-my-rabotaem/`;
const description = 'Как проходит исследование в Baikal Research: бриф и методология, сбор данных, анализ, отчёт с рекомендациями..';

const steps = [
  {
    title: 'Бриф и методология',
    text: 'Обсуждаем задачу, какое решение вы будете принимать по итогам и что уже известно. Предлагаем метод и выборку, фиксируем сроки и стоимость до начала работ.',
  },
  {
    title: 'Сбор данных',
    text: 'CATI/CAWI-опрос, интервью или юзабилити-тестирование по согласованному сценарию. Следим за квотами, качеством ответов и тем, чтобы респонденты были из вашей аудитории.',
  },
  {
    title: 'Анализ',
    text: 'Считаем статистику, проверяем данные на артефакты выборки, ищем закономерности. В интервью выделяем причины и барьеры, в опросах проверяем значимость различий между сегментами.',
  },
  {
    title: 'Отчёт с рекомендациями',
    text: 'Конкретные шаги для бизнеса, а не сырые данные без выводов. Показываем, что делать в первую очередь, и честно отмечаем, где цифры оценочные.',
  },
];

const faq = [
  { q: 'С чего начать, если задача сформулирована расплывчато?', a: 'Расскажите, что происходит в бизнесе и какое решение нужно принять. Если задача не оформлена, поможем превратить её в бриф: цель, вопросы исследования, аудитория.' },
  { q: 'Что такое бриф и обязательно ли его писать?', a: 'Бриф — это короткий документ о задаче: контекст, что уже известно, цель бизнеса, цель исследования, аудитория, срок и бюджет. Готовый бриф ускоряет работу, но если его нет, мы соберём его по разговору.' },
  { q: 'Когда я узнаю стоимость?', a: 'До начала работ. Цена зависит от метода, размера выборки и сложности аудитории, поэтому мы называем её после обсуждения задачи и фиксируем в предложении.' },
  { q: 'Можно ли обойтись без большого исследования?', a: 'Часто можно. Метод и размер выборки мы подбираем под задачу и бюджет, а не подгоняем задачу под готовый пакет. Иногда хватает 8–15 интервью или анализа открытых данных.' },
  { q: 'С кем и на каких условиях вы работаете?', a: 'С юридическими лицами, индивидуальными предпринимателями и физическими лицами. Формат договора и оплаты (предоплата, оплата по этапам или после сдачи работы) обсуждаем под клиента и задачу: подход у нас индивидуальный.' },
  { q: 'Как быстро вы отвечаете на заявку?', a: 'В течение одного рабочего дня.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'Как мы работаем', item: url },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};
---
<BaseLayout title="Как мы работаем — Baikal Research" description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <SiteHeader contactHref="#contact" />

  <main class="page">
    <nav class="breadcrumbs" aria-label="Хлебные крошки">
      <a href="/">Главная</a><span aria-hidden="true">/</span>
      <span aria-current="page">Как мы работаем</span>
    </nav>

    <h1>Как мы работаем</h1>
    <p class="lead">Из брифа в решение за понятный срок. Четыре шага: от первого разговора до отчёта, который можно использовать в решении.</p>
    <div class="page-actions">
      <a class="btn btn-primary" href="#contact">Обсудить задачу</a>
    </div>

    <h2>Четыре шага</h2>
    <ol class="steps">
      {steps.map((step) => (
        <li>
          <div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        </li>
      ))}
    </ol>

    <aside class="callout">
      <h3>Не растягиваем исследование ради объёма</h3>
      <p>Если задаче хватает меньшего, не предлагаем 100 интервью или опрос на 10 000 человек. Метод и размер выборки подбираем под задачу и бюджет, а не подгоняем задачу под прайс.</p>
    </aside>

    <h2>Что понадобится для старта</h2>
    <ul class="checks">
      <li>Контекст: чем занимается компания и на каком этапе продукт.</li>
      <li>Что уже известно: данные, прошлые исследования, гипотезы.</li>
      <li>Цель бизнеса и решение, которое вы будете принимать по результатам.</li>
      <li>Кого нужно изучить: целевая аудитория и ограничения по ней.</li>
      <li>Срок и ориентир по бюджету.</li>
    </ul>
    <p class="article-service-link">Если чего-то из списка нет, это нормально: подскажем, как сформулировать. Подробнее о методах в <a href="/blog/kachestvennye-i-kolichestvennye-issledovaniya/">статье о качественных и количественных исследованиях</a>.</p>

    <h2>Частые вопросы</h2>
    <div class="faq">
      {faq.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </main>

  <ContactBlock
    heading="Расскажите о задаче"
    subheading="Предложим метод, выборку и сроки под вашу задачу и бюджет. Цену называем до начала работ."
  />
  <SiteFooter />
</BaseLayout>

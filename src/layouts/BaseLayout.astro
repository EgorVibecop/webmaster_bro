---
import { ASSET_V } from '../config.js';
import '@fontsource-variable/onest';
import '../styles/global.css';
import '../styles/pages.css';
import fontCyrillic from '@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url';
import fontLatin from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  image?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
}

const { title, description, noindex = false, image = '/og-image-v2.jpg', ogType = 'website', publishedTime } = Astro.props;

const site = Astro.site ?? new URL('https://baikalresearch.ru');
let path = Astro.url.pathname;
if (path !== '/' && !path.endsWith('/')) path += '/';
const canonical = new URL(path, site).href;
const ogImage = new URL(image, site).href;

// Политика безопасности через meta (GitHub Pages не дает задавать HTTP-заголовки).
// Только в боевой сборке: в режиме разработки она мешает горячей перезагрузке.
// connect-src: заявки уходят на наш же домен (/api/lead.php), поэтому внешние адреса не нужны.
// frame-src – GTM-контейнер (noscript-iframe) и служебный фрейм Метрики match.html (синхронизация кук).
// GTM сам грузит другие скрипты по настройке в его панели; при добавлении
// там нового тега может понадобиться открыть его домен здесь же.
const csp = [
  "default-src 'self'",
  "script-src 'self' https://mc.yandex.ru",
  "style-src 'self'",
  "font-src 'self' data:",
  "img-src 'self' data: https://mc.yandex.ru https://mc.yandex.com",
  "connect-src 'self' https://mc.yandex.ru https://mc.yandex.com",
  "frame-src https://mc.yandex.ru https://mc.yandex.com",
  "form-action 'self'",
  "base-uri 'self'",
  "object-src 'none'",
].join('; ');
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
  <meta name="theme-color" content="#FFFFFF" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <meta property="og:type" content={ogType} />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  <meta property="og:site_name" content="Baikal Research" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Baikal Research – исследования и бизнес-консалтинг" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="preload" href={fontCyrillic} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />

  <slot name="head" />
</head>
<body>
  <slot />
  <script is:inline src={`/js/metrika.js?v=${ASSET_V}`} defer></script>
  <script is:inline src={`/js/goals.js?v=${ASSET_V}`} defer></script>
  <script is:inline src={`/js/motion.js?v=${ASSET_V}`} defer></script>
  <noscript><div><img src="https://mc.yandex.ru/watch/113551309" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
</body>
</html>
